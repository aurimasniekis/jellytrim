<Project>
  <PropertyGroup>
    <JellyfinVersion>12.4.0</JellyfinVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Host-provided: compile against, never ship. Versions must equal Jellyfin v12.4's Directory.Packages.props. -->
    <PackageVersion Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageVersion Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageVersion Include="Jellyfin.Common" Version="$(JellyfinVersion)" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Data.Sqlite.Core" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <!-- Tests only -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
  </ItemGroup>
</Project>
